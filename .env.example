# =============================================================================
# OntoRegGov 环境变量模板（v1.20.0）
#
# 用法：cp .env.example .env  → 按需填写 → docker compose 自动读取
#       （compose 默认在「仓库根目录」与「compose 文件所在目录」查找 .env）
#
# 原则：
#   1. 所有密钥 / 口令 / 宿主绝对路径只经环境变量注入，**一律不入库**；
#   2. 留空即沿用平台内置降级行为，可零密钥启动（智能抽取自动降级为规则抽取）；
#   3. 带 # 的开关项为可选覆盖，未设置时由 compose 按运行形态给默认值。
# =============================================================================

# ---- 应用与镜像 ----
TZ=Asia/Shanghai
APP_PORT=8420                    # 宿主机映射端口（业务台 + REST API）
APP_IMAGE=ontoreggov-app:local
PYTHON_VERSION=3.13              # Dockerfile ARG（镜像基础版本）
MCP_PORT=8422                    # 智能体网关（MCP）端口

# ---- 宿主目录（唯一允许出现绝对路径的地方）----
# 知识静态站目录（含 data/knowledge-data.js），只读挂载到容器 /app/kb_site
# 相对路径以 deploy/ 为基准；缺失时不阻塞启动，知识视图降级提示
KB10_SITE_HOST=./kb_site
# 独立知识工程根目录（含 ontology/ 与 data/），供平台读取权威底座
KB10_ROOT=

# ---- 读源开关（可选覆盖；未设置时：demo 形态=sqlite，full 形态=db）----
# DB_READ_FROM=sqlite            # sqlite | db
# KB_READ_FROM=canonical         # canonical | db | json
# SKIP_SEED=1                    # 1=复用卷内既有数据，不重置种子
# GRAPH_FORCE_MEMORY=1           # 1=图后端强制进程内 memory（无 Fuseki 时自包含可用）

# ---- 图存储（Apache Jena Fuseki，按需启用 --profile graph）----
GRAPH_STORE_BACKEND=memory       # memory | oxigraph | fuseki | neo4j
GRAPH_STORE_ENDPOINT=http://fuseki:3030
GRAPH_STORE_DATASET=ds
GRAPH_STORE_USER=
GRAPH_STORE_PASSWORD=
FUSEKI_PORT=3030

# ---- 关系型投影库（PostgreSQL，只读投影；未配置自动降级）----
# 形如 postgresql://<user>:<password>@<host>:<port>/<db>
KB_PG_DSN=

# ---- LLM 抽取（OpenAI 兼容端点；留空自动降级为确定性规则抽取）----
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- WeKnora 知识库底座（可选，full 形态使用）----
WEKNORA_API_BASE=
WEKNORA_API_TOKEN=
WEKNORA_KB_ID=
WEKNORA_PG_HOST=
WEKNORA_PG_PORT=5432
WEKNORA_PG_USER=
WEKNORA_PG_PASSWORD=
WEKNORA_PG_DB=
WEKNORA_NEO4J_URI=
WEKNORA_NEO4J_USER=
WEKNORA_NEO4J_PASSWORD=

# ---- RAGFlow / TEI 向量检索（可选）----
RAGFLOW_BASE=
RAGFLOW_API_TOKEN=
RAGFLOW_DATASET_ID=
TEI_EMBED_URL=

# ---- OpenClaw 合规自查智能体（可选，需先具备构建产物）----
OPENCLAW_IMAGE=node:22-alpine
OPENCLAW_GATEWAY_URL=            # 容器内填 http://openclaw-gateway:18789
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_BIND=loopback   # 容器内需为 0.0.0.0
OPENCLAW_GATEWAY_TOKEN=          # 留空则自动生成并写入 openclaw.json（不入库）
OPENCLAW_NODE_BIN=               # 显式指定 node 可执行文件（跨平台/离线）
OPENCLAW_LLM_BASE_URL=
OPENCLAW_LLM_API_KEY=
OPENCLAW_PROVIDER=qwen
OPENCLAW_LLM_MODEL_ID=qwen3.8-flash
OPENCLAW_LLM_MODEL_NAME=Qwen3.8 Flash
OPENCLAW_LOG_LEVEL=info

# ---- 网关鉴权（REST /api 与 MCP 共用同一把钥匙板）----
GATEWAY_AUTH_ENABLED=off         # on= /api/* 强制 Bearer + 限流 + 审计
MCP_ALLOWLIST_PATH=              # 外部真实钥匙板路径；留空用内置演示钥匙板

# ---- 外部底座网络（full 形态复用既有 WeKnora 网络）----
EKOS_NETWORK=compose_weknora-net
