# 运行时产物（SQLite / 生成的 ttl）不入库；data/.gitkeep 保留空目录
.venv/
__pycache__/
*.pyc
app/data/*.db
app/data/*.db-*
app/data/*.ttl
!app/data/.gitkeep
.DS_Store

# 知识库发布影子站（生成物，由 scripts/kb_publish.py 重建，~67M）
.kb-publish/

# 数据库备份（含内部 PG dump，不入库）
backups/

# 运行时上传与预览（用户证据附件 / 站点预览）
app/data/evidence_uploads/
app/data/site-preview/

# 日志与 WAL
*.log
*.db-wal
*.db-shm

# 备份文件与导出产物
*.bak*

# 本地验收/QA 报告产物（仅本地留存，不入库）
reports/
QA_ACCEPTANCE_REPORT_*.md
data/*

# v1.18.0 OpenClaw 智能体服务整合：构建产物/依赖/运行态体积巨大（~3GB），不入库
# （配置 openclaw.json 与启动脚本入库；重建方法见 README「OpenClaw 智能体服务」节）
services/openclaw/node_modules/
services/openclaw/dist/
services/openclaw/state/
services/openclaw/workspace*/
services/openclaw/packages/
services/openclaw/evidence-kit/.venv/
services/openclaw/evidence-kit/hf-cache/
services/openclaw/*.mjs
services/openclaw/*.d.mts
services/openclaw/package.json
services/openclaw/pnpm-lock.yaml
services/openclaw/pnpm-workspace.yaml

# 本地代理/工具数据，不入库
.workbuddy/
.tooling/
